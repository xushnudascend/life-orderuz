{
  "name": "Life Order — Hayotingni tartibga sol",
  "short_name": "Life Order",
  "description": "Self-Control OS — o'z-o'zini boshqarish operatsion tizimi. Trigger tahlili, kunlik uchta qadam, halol AI mentor Nadir.",
  "id": "/",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "tabbed", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0A0A0A",
  "theme_color": "#0A0A0A",
  "lang": "uz",
  "dir": "ltr",
  "categories": ["productivity", "lifestyle", "health"],
  "iarc_rating_id": "e58c174a-81d2-5c3c-32cc-34308cf0f1bf",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/apple-touch-icon.png", "sizes": "180x180", "type": "image/png", "purpose": "any" }
  ],
  "screenshots": [
    {
      "src": "/screenshots/mobile-1.jpg",
      "sizes": "720x1280",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "Life Order — Dashboard (mobil)"
    },
    {
      "src": "/screenshots/desktop-1.jpg",
      "sizes": "1280x800",
      "type": "image/jpeg",
      "form_factor": "wide",
      "label": "Life Order — Dashboard (desktop)"
    }
  ],
  "shortcuts": [
    {
      "name": "Dashboard",
      "short_name": "Dashboard",
      "description": "Bugungi streak va quest",
      "url": "/dashboard?source=pwa-shortcut",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Kundalik",
      "short_name": "Journal",
      "description": "Tezkor yozuv qo'shish",
      "url": "/journal?source=pwa-shortcut",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Nadir bilan suhbat",
      "short_name": "Mentor",
      "description": "AI mentor bilan gaplash",
      "url": "/mentor?source=pwa-shortcut",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Odatlar",
      "short_name": "Habits",
      "description": "Odatlarni log qilish",
      "url": "/habits?source=pwa-shortcut",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "handle_links": "preferred",
  "edge_side_panel": {
    "preferred_width": 400
  },
  "share_target": {
    "action": "/journal",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+lifeorder",
      "url": "/?deeplink=%s"
    }
  ],
  "file_handlers": [
    {
      "action": "/journal",
      "accept": {
        "text/plain": [".txt", ".md"]
      },
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "scope_extensions": [
    { "origin": "https://life-orderuz.lovable.app" }
  ],
  "note_taking": {
    "new_note_url": "/journal?new=1"
  },
  "widgets": [
    {
      "name": "Bugungi streak",
      "short_name": "Streak",
      "description": "Bugungi streak va uchta qadam",
      "tag": "today",
      "ms_ac_template": "/widgets/today.json",
      "data": "/widgets/today-data.json",
      "type": "application/json",
      "screenshots": [
        {
          "src": "/screenshots/mobile-1.jpg",
          "sizes": "720x1280",
          "label": "Bugungi streak widget"
        }
      ],
      "icons": [
        { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }
      ],
      "backgrounds": [
        { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" }
      ]
    }
  ],
  "prefer_related_applications": false,
  "related_applications": []
}
